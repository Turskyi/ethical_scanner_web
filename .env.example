# Create .env.local for local development and set these in Vercel for deployment.
# Use API keys dedicated to Ethical Scanner; never place these in the Flutter app.
# Before enabling these keys in production, rate-limit POST /api/ai/barcode-info
# with a Vercel Firewall rule and set provider-side usage limits.
#https://console.groq.com/keys
GROQ_API_KEY=
#https://openrouter.ai/workspaces/ethical-scanner/keys
OPENROUTER_API_KEY=
#https://aistudio.google.com/api-keys
GEMINI_API_KEY=
